tenancy     = "ocid1.tenancy.oc1..aaaa..."
user        = "ocid1.user.oc1..aaaa..."
fingerprint = "aa:bb:cc:dd:..."

region = "ap-sydney-1"
subnet = "ocid1.subnet.oc1.ap-sydney-1..aaaa..."

# Existing compartment. Set create_compartment = true only for a fresh tenancy.
compartment        = "ocid1.compartment.oc1..aaaa..."
create_compartment = false

ssh_public_key = "ssh-ed25519 AAAA... you@example"

# Budget alerts (AUD). Governance resources need tenancy-admin rights.
alert_email      = "you@example.com"
budget_amount_aud = 1
